rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper functions use `resource.data.get(key, default)` for every optional
    // field. Firestore 'list' rule evaluation is strict on undefined field
    // access and throws PERMISSION_DENIED instead of treating missing fields as
    // null (production error: "Property visibility is undefined on object.
    // for 'list' @ L32"). Defaults match RegistryDto defaults so new-doc
    // semantics are unchanged; legacy docs predating the visibility /
    // invitedUsers fields (Phase 03) are handled via the defaults.
    function isOwner(registryData) {
      // Empty-string default fails closed — no client has auth.uid == '' so a
      // doc missing ownerId is unreadable/unwritable by every caller.
      return isSignedIn() && request.auth.uid == registryData.get('ownerId', '');
    }

    function isPublicRegistry(registryData) {
      // Legacy docs predate `visibility` (added in Phase 03). Default to
      // 'public' to match RegistryDto.visibility = "public" — avoids the
      // PERMISSION_DENIED throw on undefined field access in list evaluation.
      return registryData.get('visibility', 'public') == 'public';
    }

    function isInvited(registryData) {
      // Defensive .get() for both fields. Legacy docs predate `invitedUsers`;
      // empty-map default means no one is invited, which is safe.
      return isSignedIn() &&
             registryData.get('visibility', 'public') == 'private' &&
             registryData.get('invitedUsers', {})[request.auth.uid] == true;
    }

    function isPendingInvited(registryData) {
      // Quick 260605-h1d: A pending invite stores the uid in `pendingInvitedUsers`
      // (separate from `invitedUsers`) until the acceptInvite Cloud Function promotes
      // it. The invite-response sheet fetches the live registry doc to show
      // description/location/date, so pending invitees need DOC read access.
      // Scoped to the registry DOC read ONLY (see line 50) — the items subcollection
      // read still uses canReadRegistry(), so pending invitees CANNOT read items.
      return isSignedIn() &&
             registryData.get('visibility', 'public') == 'private' &&
             registryData.get('pendingInvitedUsers', {})[request.auth.uid] == true;
    }

    function canReadRegistry(registryData) {
      // isOwner first: belt-and-suspenders defense. For owner-filtered list
      // queries (whereEqualTo('ownerId', uid)) isOwner short-circuits true
      // and the visibility/invitedUsers checks are skipped entirely — no
      // field-access path can throw on legacy docs even if .get() were wrong.
      return isOwner(registryData) ||
             isPublicRegistry(registryData) ||
             isInvited(registryData);
    }

    // Registries collection
    match /registries/{registryId} {
      allow read: if canReadRegistry(resource.data) || isPendingInvited(resource.data);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);

      // Items subcollection — inherits registry visibility for reads
      match /items/{itemId} {
        allow read: if canReadRegistry(
          get(/databases/$(database)/documents/registries/$(registryId)).data
        );
        allow create, update, delete: if isOwner(
          get(/databases/$(database)/documents/registries/$(registryId)).data
        );
      }

      // Invites subcollection — owner-only read/write
      match /invites/{inviteId} {
        allow read, write: if isOwner(
          get(/databases/$(database)/documents/registries/$(registryId)).data
        );
      }
    }

    // Phase 4 (RES-09 / D-19): Reservations are ONLY writable by Cloud Functions
    // via Admin SDK (which bypasses rules). All client writes are denied.
    // createReservation callable runs a runTransaction to guarantee atomicity.
    match /reservations/{reservationId} {
      allow read, write: if false;
    }

    // Users — owner reads/writes their own document only
    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Phase 6: mail collection — Trigger Email extension manages via Admin SDK.
    // No client read or write is allowed.
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Phase 6: notifications_failures — ops-only log (Admin SDK bypasses rules).
    match /notifications_failures/{docId} {
      allow read, write: if false;
    }

    // Phase 6: FCM tokens subcollection — each user owns their own tokens.
    // Another user cannot enumerate or read another user's tokens.
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Quick task 260420-ozb: Persistent in-app notifications inbox — per-user subcollection.
    // Admin SDK writes via writeNotification helper; clients can read their
    // own entries and flip readAt, nothing else.
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if false;
      // Client updates limited to readAt only — prevents tampering with type/payload.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["readAt"]);
      allow delete: if false;  // v1: no user-initiated deletion
    }

    // Phase 7 config/{configId} rule deleted in Plan 17-01 (D-07 / D-44) —
    // the Stores capability was decommissioned and the only document under
    // that path (config/stores) is removed during the Plan 17-06 deploy via
    // functions/scripts/deleteConfigStores.ts.

    // Phase 17 D-43: popularItems — global community popularity counter docs.
    // Maintained by Cloud Functions triggers (Admin SDK bypasses rules).
    // Reads allowed for any authenticated NON-anonymous user.
    // Anonymous web-fallback guests (Phase 5) are excluded — Discover is
    // for registered users only per D-12.
    match /popularItems/{productId} {
      allow read: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider != "anonymous";
      allow write: if false;
    }

    // Phase 17 D-43: discoverCache — server-only cache for Gemini search
    // results. No client read or write — Cloud Functions Admin SDK only.
    match /discoverCache/{normalizedQuery} {
      allow read, write: if false;
    }

    // Phase 17 D-43: discoverRateLimits — server-only per-user rate-limit
    // counters for discoverSearch. No client read or write — prevents
    // client-side tampering of the call timestamp array.
    match /discoverRateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
